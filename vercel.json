{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/cap/pcyes", "destination": "/case/pcyes", "permanent": true },
    { "source": "/cap/locarmais-conciliacao", "destination": "/case/locarmais-conciliacao", "permanent": true },
    { "source": "/cap/odex", "destination": "/case/odex", "permanent": true },
    { "source": "/cap/oderco-revenda", "destination": "/case/oderco-revenda", "permanent": true },
    { "source": "/cap/:id", "destination": "/", "permanent": true },
    { "source": "/empresa/:id", "destination": "/", "permanent": true },
    { "source": "/rapido", "destination": "/", "permanent": true },
    { "source": "/v2", "destination": "/", "permanent": true },
    { "source": "/v2/case/:id", "destination": "/case/:id", "permanent": true },
    { "source": "/v2/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!llms\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/volume/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/volume/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
